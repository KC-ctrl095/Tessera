{
  "name": "tessera-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tessera web UI (Tauri desktop/Android app and `tessera serve`)",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:voice": "node tests/voice-unit.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "mock": "node dev/mock-server.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-barcode-scanner": "~2.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "solid-js": "^1.9.15",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "parse5": "^7.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14"
  }
}
